//@version=5
// TBD W/M SAR v30 — Champion (Multi-TF BoS-Struktur + ER-Clarity-Filter)
// v27 (20.8.26): Status als LABEL statt Tabelle (Tabelle wurde nicht gerendert).
// v26 (20.8.26): ZYKLUS-LEVELS DER ENGINE SICHTBAR — zeigt WO die Engine im
//   3-Level-Zyklus steht: Marker bei jedem Stufenwechsel auf 4h und 1h, Faerbung
//   bei 4h-Stufe 3 (Erschoepfung = Reversal scharf), Status-Box unten rechts.
//   Damit vergleichbar mit dem eigenen TBD-Read. Keine Logikaenderung.
// v25 (20.8.26): LESBARKEIT — (a) Status-Zeile in Klartext (warum feuert die Engine
//   gerade nicht?), (b) Roadblock als BAND statt Linie und nur wenn das Reversal
//   wirklich scharf ist (4h-Stufe 3), (c) Key-Levels mit Preis-Label am rechten Rand.
//   Keine Logikaenderung — reine Darstellung.
// v24 (19.8.26): VEKTOR-FENSTER — ta.sma(volume,10) schliesst die AKTUELLE Kerze ein,
//   Python (und PVSRA/TBD-Definition: "average of the PRIOR 10 candles") NICHT.
//   Folge: Vektor-Schwelle zu hoch -> Pine verpasste Roh-BCRs (4J: Python 2039 vs Pine 1893).
//   Fix: ta.sma(volume,10)[1] an beiden Stellen (Struktur-Level + BCR).
// v23 (19.8.26): PYTHON-PARITÄT — zwei systematische Divergenzen gefixt:
//   (1) HTF-Kontext (Bias/Level/ER) wurde intrabar gelesen (laufender HTF-Bar),
//       Python nutzt den letzten GESCHLOSSENEN HTF-Bar. Pine lief bis zu 4h voraus
//       -> 9,2% aller 15m-Bars hatten eine andere ER-Gate-Entscheidung. Jetzt [1]+lookahead_on.
//   (2) HOD/LOD/HOW/LOW lagen auf TV-Session (UTC), Python ankert 17:00 NY (So 17:00 = Wochenstart).
//       Jetzt manuell auf 17:00-NY verankert = Roadblock-Gate identisch.
// v22 (21.7.26): (a) BCR-200EMA-Regel — Break muss zur 15m-200EMA laufen, bevor der
//   50EMA-Retest gilt (blockt Sofort-Signale nach Break); (b) Time-Stop: nach 5 Tagen
//   unter +1R raus (Plateau 4-7d, cross-coin validiert).
//   Python-Referenz v22: BTC 4J +460% / PF 3.75 / DD 18% / WR 21% / OOS +63%.
// v21 (14.7.26): BCR_WT_ONLY — BCR ist Continuation-Pattern, nur with-trend,
//   nie als Counter-Trend-Reversal (bcr/rev war das Leck: PF 0.14).
//   Python-Referenz: +408% / DD 21% / OOS +62% (4J BTC Perp 15m).
// Faithful Port von wm_sar_mtf.py. Einzelposition, SAR-Runner, kein TP.
// Config: REV_1D 0.066 / 4H 0.033 / 1H 0.0165, ER_MIN 0.20, M/W + BCR-flat.
strategy("TBD W/M SAR v30 Champion", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=0, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.045, max_labels_count=500, max_lines_count=500)

// ================= INPUTS =================
grpF = "Filter / Struktur"
rev1d  = input.float(0.066, "rev 1D",  group=grpF, step=0.001)
rev4h  = input.float(0.033, "rev 4H",  group=grpF, step=0.001)
rev1h  = input.float(0.0165,"rev 1H",  group=grpF, step=0.001)
erN    = input.int(30,      "ER Fenster (4h Bars)", group=grpF)
erMin  = input.float(0.20,  "ER_MIN (Clarity)", group=grpF, step=0.01)
lvVec  = input.float(1.5,   "Level-Vektor x SMA10", group=grpF, step=0.1)
rbTol  = input.float(0.005, "Roadblock-Toleranz", group=grpF, step=0.001)
useMacro = input.bool(true, "1D-Makro muss With-Trend tragen", group=grpF)

grpE = "Entries"
useMW  = input.bool(true, "M/W Entries", group=grpE)
useBCR = input.bool(true, "BCR-flat Entries", group=grpE)
bcrWtOnly = input.bool(true, "BCR nur with-trend (v21)", group=grpE, tooltip="BCR ist ein Continuation-Pattern: nie als Counter-Trend-Reversal-Trigger. Reversals nur per M/W.")
bcrVec = input.float(1.5, "BCR-Vektor x SMA10", group=grpE, step=0.1)
bcrWin = input.int(120,   "BCR Fenster (Bars)", group=grpE)
bcrTol = input.float(0.0015,"BCR Retest-Toleranz", group=grpE, step=0.0005)
bcr200On  = input.bool(true, "BCR: Break muss zur 200EMA laufen (v22)", group=grpE, tooltip="Retest erst gültig, wenn der Preis seit dem Break die 15m-200EMA erreicht hat (Long: High rauf, Short: Low runter).")
bcr200Tol = input.float(0.002, "BCR 200EMA-Toleranz", group=grpE, step=0.001)
swLB   = input.int(20,    "SL Swing-Lookback", group=grpE)

grpV = "Anzeige"
showTable = input.bool(true,  "Engine-Status anzeigen (Label rechts)", group=grpV)
showLvl   = input.bool(true,  "Zyklus-Stufen der Engine markieren (4h/1h)", group=grpV)
showL3    = input.bool(true,  "4h-Stufe 3 einfaerben (Erschoepfung)", group=grpV)
showZones = input.bool(true,  "Roadblock-Zonen anzeigen (nur wenn scharf)", group=grpV)
showLbl   = input.bool(true,  "Preis-Labels am rechten Rand", group=grpV)

grpR = "Risk"
riskP  = input.float(1.0, "Risiko % / Trade", group=grpR, step=0.1)
maxLev = input.float(10.0,"Max Hebel", group=grpR, step=1.0)
tsD    = input.float(5.0, "Time-Stop Tage (0=aus) (v22)", group=grpR, step=1.0)
tsR    = input.float(1.0, "Time-Stop R-Schwelle", group=grpR, step=0.5)

// ================= HELPER =================
f_isHammer(o,h,l,c) =>
    rng = h - l
    rng <= 0 ? false : (math.min(o,c) - l) >= 0.5*rng and math.abs(c-o) <= 0.4*rng
f_isInvHammer(o,h,l,c) =>
    rng = h - l
    rng <= 0 ? false : (h - math.max(o,c)) >= 0.5*rng and math.abs(c-o) <= 0.4*rng

// ---- Multi-TF Struktur (kausaler ZigZag BoS + Level-State) ----
// gibt [trend(+1/-1/0), level(0..3)] zurueck. var-State laeuft im security-Kontext.
f_struct(rev, vmult) =>
    e50s = ta.ema(close, 50)
    vsma = ta.sma(volume, 10)[1]   // v24: vorherige 10 Kerzen, OHNE die aktuelle
    vec = vsma > 0 and volume >= vmult*vsma
    var float hi = high
    var float lo = low
    var int dirn = 0
    var float prevSH = na
    var float prevSL = na
    var int trend = 0
    var int level = 0
    var int st = 0          // 0 SEEK 1 L1 2 BOARD1 3 L2 4 BOARD2 5 L3
    var bool free = true
    int ptyp = 0
    float ppx = na
    if dirn >= 0
        if high > hi
            hi := high
        if low < hi*(1.0-rev)
            ptyp := 1
            ppx := hi
            dirn := -1
            lo := low
    if ptyp == 0 and dirn <= 0
        if low < lo
            lo := low
        if high > lo*(1.0+rev)
            ptyp := -1
            ppx := lo
            dirn := 1
            hi := high
    if ptyp == 1
        bosUp = not na(prevSH) and ppx > prevSH
        if bosUp and trend != 1
            trend := 1
            level := 0
            st := 0
            free := true
        else if trend == -1
            if st == 1 or st == 3
                st := st == 1 ? 2 : 4
            free := true
        prevSH := ppx
    else if ptyp == -1
        bosDn = not na(prevSL) and ppx < prevSL
        if bosDn and trend != -1
            trend := -1
            level := 0
            st := 0
            free := true
        else if trend == 1
            if st == 1 or st == 3
                st := st == 1 ? 2 : 4
            free := true
        prevSL := ppx
    if trend != 0 and vec and free
        beyond = (trend == 1 and close > e50s) or (trend == -1 and close < e50s)
        if beyond
            if st == 0 and level == 0
                level := 1
                st := 1
                free := false
            else if st == 2
                level := 2
                st := 3
                free := false
            else if st == 4
                level := 3
                st := 5
                free := false
    [trend, level]

// ---- Efficiency Ratio ----
f_er(n) =>
    net = math.abs(close - close[n])
    den = math.sum(math.abs(close - close[1]), n)
    den > 0 ? net/den : 0.0

// ================= MULTI-TF CONTEXT =================
// [1] + lookahead_on = letzter GESCHLOSSENER HTF-Bar (Non-Repaint-Idiom).
// Entspricht map_to_15m() der Python-Engine. NICHT auf lookahead_off ohne [1]
// zurueckbauen — das liest den laufenden HTF-Bar und laeuft dem Python voraus.
f_struct_conf(rev, vmult) =>
    [t, l] = f_struct(rev, vmult)
    [t[1], l[1]]
f_er_conf(n) =>
    e = f_er(n)
    e[1]

[d1d, l1d] = request.security(syminfo.tickerid, "D",   f_struct_conf(rev1d, lvVec), lookahead=barmerge.lookahead_on)
[d4h, l4h] = request.security(syminfo.tickerid, "240", f_struct_conf(rev4h, lvVec), lookahead=barmerge.lookahead_on)
[d1h, l1h] = request.security(syminfo.tickerid, "60",  f_struct_conf(rev1h, lvVec), lookahead=barmerge.lookahead_on)
er4h       = request.security(syminfo.tickerid, "240", f_er_conf(erN), lookahead=barmerge.lookahead_on)

// ================= KEY LEVELS (HOW/LOW/HOD/LOD, Anker 17:00 NY) =================
// v23: manuell verankert statt TV-Session ("D"/"W" = UTC bei Krypto!).
// Python key_levels(): Tag beginnt 17:00 NY, Woche So 17:00 NY, letzte ABGESCHLOSSENE Periode.
nyHour = hour(time, "America/New_York")
nyDow  = dayofweek(time, "America/New_York")
newDay  = nyHour == 17 and nyHour[1] != 17
newWeek = newDay and nyDow == dayofweek.sunday

f_prevExtremes(resetCond) =>
    var float curHi = na
    var float curLo = na
    var float pHi = na
    var float pLo = na
    if resetCond
        pHi := curHi
        pLo := curLo
        curHi := high
        curLo := low
    else
        curHi := na(curHi) ? high : math.max(curHi, high)
        curLo := na(curLo) ? low  : math.min(curLo, low)
    [pHi, pLo]

[hod, lod]  = f_prevExtremes(newDay)
[how, low_] = f_prevExtremes(newWeek)

// ================= CHART TF (15m): EMA + M/W + BCR =================
e50 = ta.ema(close, 50)
e200 = ta.ema(close, 200)
vsma10 = ta.sma(volume, 10)[1]   // v24: vorherige 10 Kerzen, OHNE die aktuelle (= Python/PVSRA)
lowSw = ta.lowest(low, swLB)
highSw = ta.highest(high, swLB)
piv = 4
locHigh = high >= ta.highest(high, piv)[1]
locLow  = low  <= ta.lowest(low, piv)[1]
ih = f_isInvHammer(open, high, low, close)
ha = f_isHammer(open, high, low, close)

// ---- M/W State (v13) ----
var float mp1 = na
var int   mp1bar = na
var int   mp2bar = na
var float mtrough = na
var float mwl = na
var float mp2peak = na
var float wp1 = na
var int   wp1bar = na
var int   wp2bar = na
var float wpeak = na
var float wwl = na
var float wp2tr = na
mwMin = 4
mwMax = 60
fib = 0.618
emaTol = 0.0005
mSig = false
wSig = false
float mP1lvl = na
float wP1lvl = na
mwlim = math.max(open,close) + 0.5*(high - math.max(open,close))
wwlim = math.min(open,close) - 0.5*(math.min(open,close) - low)

// M-Erkennung
if na(mp1)
    if ih and locHigh and close > e50
        mp1 := high
        mp1bar := bar_index
        mp2bar := na
        mtrough := low
        mwl := mwlim
else
    if high > mp1
        if ih and locHigh and close > e50
            mp1 := high
            mp1bar := bar_index
            mp2bar := na
            mtrough := low
            mwl := mwlim
        else
            mp1 := na
            mp2bar := na
    else if (bar_index - mp1bar) > mwMax
        mp1 := na
        mp2bar := na
    else
        mtrough := math.min(mtrough, low)
        if na(mp2bar)
            if (bar_index - mp1bar) >= mwMin and low <= e50*(1+emaTol)
                mp2bar := bar_index
                mp2peak := close
        else
            fiblvl = mtrough + fib*(mp1 - mtrough)
            if (bar_index - mp2bar) >= mwMin and ih and locHigh and close > e50 and high <= mp1 and high >= fiblvl and high <= mwl and high >= mp2peak and close < mp1
                mSig := true
                mP1lvl := mp1
                mp1 := na
                mp2bar := na
            mp2peak := math.max(mp2peak, close)

// W-Erkennung
if na(wp1)
    if ha and locLow and close < e50
        wp1 := low
        wp1bar := bar_index
        wp2bar := na
        wpeak := high
        wwl := wwlim
else
    if low < wp1
        if ha and locLow and close < e50
            wp1 := low
            wp1bar := bar_index
            wp2bar := na
            wpeak := high
            wwl := wwlim
        else
            wp1 := na
            wp2bar := na
    else if (bar_index - wp1bar) > mwMax
        wp1 := na
        wp2bar := na
    else
        wpeak := math.max(wpeak, high)
        if na(wp2bar)
            if (bar_index - wp1bar) >= mwMin and high >= e50*(1-emaTol)
                wp2bar := bar_index
                wp2tr := close
        else
            fibW = wpeak - fib*(wpeak - wp1)
            if (bar_index - wp2bar) >= mwMin and ha and locLow and close < e50 and low >= wp1 and low <= fibW and low >= wwl and low <= wp2tr and close > wp1
                wSig := true
                wP1lvl := wp1
                wp1 := na
                wp2bar := na
            wp2tr := math.min(wp2tr, close)

// ---- BCR-flat State ----
var int   cLbar = na
var float cLsl = na
var bool  cLexp = false
var int   cSbar = na
var float cSsl = na
var bool  cSexp = false
vecB = vsma10 > 0 and volume >= bcrVec*vsma10
bcrL = false
bcrS = false
float bcrLsl = na
float bcrSsl = na
// LONG
if vecB and close > e50 and (open <= e50 or close[1] <= e50[1])
    cLbar := bar_index
    cLsl := lowSw
    cLexp := false
if not na(cLbar)
    if bar_index - cLbar > bcrWin
        cLbar := na
    else if close < cLsl
        cLbar := na
    else
        if not cLexp
            cLexp := not bcr200On or high >= e200*(1 - bcr200Tol)
        else
            if low <= e50*(1+bcrTol) and close > e50 and low > cLsl and f_isHammer(open,high,low,close)
                bcrL := true
                bcrLsl := cLsl
                cLbar := na
// SHORT
if vecB and close < e50 and (open >= e50 or close[1] >= e50[1])
    cSbar := bar_index
    cSsl := highSw
    cSexp := false
if not na(cSbar)
    if bar_index - cSbar > bcrWin
        cSbar := na
    else if close > cSsl
        cSbar := na
    else
        if not cSexp
            cSexp := not bcr200On or low <= e200*(1 + bcr200Tol)
        else
            if high >= e50*(1-bcrTol) and close < e50 and high < cSsl and f_isInvHammer(open,high,low,close)
                bcrS := true
                bcrSsl := cSsl
                cSbar := na

// ================= SIGNALE + GATE =================
// Long-Signale (d=+1): W oder BCR-Long ; Short (d=-1): M oder BCR-Short
// v21: BCR nur with-trend (d == 4h-Bias) — als Reversal-Trigger gesperrt
bcrLok = useBCR and bcrL and strategy.position_size == 0 and (not bcrWtOnly or d4h == 1)
bcrSok = useBCR and bcrS and strategy.position_size == 0 and (not bcrWtOnly or d4h == -1)
longSig  = (useMW and wSig) or bcrLok
shortSig = (useMW and mSig) or bcrSok
// SL-Referenz
longSL  = wSig ? wP1lvl : bcrLsl
shortSL = mSig ? mP1lvl : bcrSsl

f_gate(d) =>
    ok = true
    bias = d4h
    if bias == 0
        ok := false
    else if er4h < erMin
        ok := false
    else if d == bias
        if (d == 1 ? l1h : l1h) >= 3
            ok := false
        if useMacro and d1d != 0 and d1d != d
            ok := false
    else
        if l4h < 3
            ok := false
        else
            px = close
            near = d == 1 ? ((not na(low_) and px <= low_*(1+rbTol)) or (not na(lod) and px <= lod*(1+rbTol))) : ((not na(how) and px >= how*(1-rbTol)) or (not na(hod) and px >= hod*(1-rbTol)))
            if not near
                ok := false
    ok

goLong  = longSig  and f_gate(1)
goShort = shortSig and f_gate(-1)

// ================= SAR RUNNER + SIZING =================
var float trailStop = na
var float entryRisk = na
f_qty(entry, sl) =>
    dist = math.abs(entry - sl)
    dist <= 0 ? 0.0 : math.min(strategy.equity*riskP/100/dist, maxLev*strategy.equity/entry)

// Flip / Entry
if goLong
    q = f_qty(close, longSL)
    if q > 0
        strategy.entry("L", strategy.long, qty=q)
        trailStop := longSL
        entryRisk := math.abs(close - longSL)
if goShort
    q = f_qty(close, shortSL)
    if q > 0
        strategy.entry("S", strategy.short, qty=q)
        trailStop := shortSL
        entryRisk := math.abs(close - shortSL)

// SAR-Trail: gleichgerichtetes Signal zieht Stop nach (Label-Kerze)
if strategy.position_size > 0
    if wSig and not na(wP1lvl) and wP1lvl > trailStop and wP1lvl < close
        trailStop := wP1lvl
    strategy.exit("Lx", "L", stop=trailStop)
if strategy.position_size < 0
    if mSig and not na(mP1lvl) and mP1lvl < trailStop and mP1lvl > close
        trailStop := mP1lvl
    strategy.exit("Sx", "S", stop=trailStop)

// ---- v22 Time-Stop: nach tsD Tagen unter tsR R -> raus ----
if tsD > 0 and strategy.position_size != 0 and strategy.opentrades > 0 and not na(entryRisk) and entryRisk > 0
    eT = strategy.opentrades.entry_time(strategy.opentrades - 1)
    eP = strategy.opentrades.entry_price(strategy.opentrades - 1)
    dirn = strategy.position_size > 0 ? 1 : -1
    urr = (close - eP) * dirn / entryRisk
    if (time - eT) >= tsD * 86400000 and urr < tsR
        strategy.close_all(comment="TimeStop")

// ================= PLOTS =================
// ---- Marker wie v19 ----
// Roh-Signale (M/W-Formation + BCR), unabhaengig vom Gate
plotshape(wSig, "W", shape.labelup,   location.belowbar, color.new(color.green,10), text="W", textcolor=color.white, size=size.small)
plotshape(mSig, "M", shape.labeldown, location.abovebar, color.new(color.red,10),   text="M", textcolor=color.white, size=size.small)
plotshape(useBCR and bcrL, "BCR L", shape.triangleup,   location.belowbar, color.new(color.aqua,0),    text="B", textcolor=color.white, size=size.tiny)
plotshape(useBCR and bcrS, "BCR S", shape.triangledown, location.abovebar, color.new(color.fuchsia,0), text="B", textcolor=color.white, size=size.tiny)
// Tatsaechlich genommene Entries (nach Gate)
// Entry mit Grund beschriften: REV (Reversal/Counter-Trend) vs WT (With-Trend) + 4h-Level
if goLong
    isRev = d4h != 1
    label.new(bar_index, low, "L " + (isRev ? "REV L" + str.tostring(l4h) : "WT"), yloc=yloc.belowbar, style=label.style_label_up, color=isRev ? color.new(color.orange,0) : color.new(color.lime,0), textcolor=color.white, size=size.small)
if goShort
    isRev = d4h != -1
    label.new(bar_index, high, "S " + (isRev ? "REV L" + str.tostring(l4h) : "WT"), yloc=yloc.abovebar, style=label.style_label_down, color=isRev ? color.new(color.orange,0) : color.new(color.red,0), textcolor=color.white, size=size.small)
// SL-Linie (SAR-Trail), nur in Position
plot(strategy.position_size != 0 ? trailStop : na, "SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(e50,  "50 EMA",  color=color.new(#2962FF, 0), linewidth=2)   // blau
plot(e200, "200 EMA", color=color.new(#FFD700, 0), linewidth=2)   // gelb
// ---- v25: Roadblock-ZONEN statt nackter Linien ----
// Nur einblenden, wenn ein Reversal ueberhaupt feuern koennte (4h-Stufe 3 + Gegenrichtung).
armedShort = showZones and d4h == 1  and l4h >= 3   // Short-Reversal moeglich -> obere Levels zaehlen
armedLong  = showZones and d4h == -1 and l4h >= 3   // Long-Reversal moeglich  -> untere Levels
pHowU = plot(armedShort and not na(how)  ? how*(1+rbTol)  : na, display=display.none)
pHowD = plot(armedShort and not na(how)  ? how*(1-rbTol)  : na, display=display.none)
pHodU = plot(armedShort and not na(hod)  ? hod*(1+rbTol)  : na, display=display.none)
pHodD = plot(armedShort and not na(hod)  ? hod*(1-rbTol)  : na, display=display.none)
pLowU = plot(armedLong  and not na(low_) ? low_*(1+rbTol) : na, display=display.none)
pLowD = plot(armedLong  and not na(low_) ? low_*(1-rbTol) : na, display=display.none)
pLodU = plot(armedLong  and not na(lod)  ? lod*(1+rbTol)  : na, display=display.none)
pLodD = plot(armedLong  and not na(lod)  ? lod*(1-rbTol)  : na, display=display.none)
fill(pHowU, pHowD, color=color.new(color.red,   80), title="Zone Wochenhoch")
fill(pHodU, pHodD, color=color.new(color.orange,85), title="Zone Tageshoch")
fill(pLowU, pLowD, color=color.new(color.green, 80), title="Zone Wochentief")
fill(pLodU, pLodD, color=color.new(color.lime,  85), title="Zone Tagestief")
// duenne Referenzlinien (dezent)
plot(hod, "Tageshoch",  color=color.new(color.gray,65), style=plot.style_stepline)
plot(lod, "Tagestief",  color=color.new(color.gray,65), style=plot.style_stepline)
plot(how, "Wochenhoch", color=color.new(color.purple,55), style=plot.style_stepline, linewidth=2)
plot(low_,"Wochentief", color=color.new(color.purple,55), style=plot.style_stepline, linewidth=2)

// ---- v25: Preis-Labels am rechten Rand ----
var label lHow = na
var label lLow = na
var label lHod = na
var label lLod = na
f_tag(lb, px, txt, col) =>
    label.delete(lb)
    label rv = na
    if not na(px)
        rv := label.new(bar_index, px, txt + " " + str.tostring(px, format.mintick), style=label.style_label_left, color=color.new(col, 20), textcolor=color.white, size=size.small)
    rv
if showLbl and barstate.isconfirmed
    lHow := f_tag(lHow, how,  "Wochenhoch", color.purple)
    lLow := f_tag(lLow, low_, "Wochentief", color.purple)
    lHod := f_tag(lHod, hod,  "Tageshoch",  color.gray)
    lLod := f_tag(lLod, lod,  "Tagestief",  color.gray)

// ---- v26: ZYKLUS-STUFEN der Engine markieren ----
// Die Engine zaehlt pro TF: Stufe 1 = 1. Vektor-Bruch der 50er nach Struktur-Flip,
// Stufe 2 nach dem 1. Board-Meeting, Stufe 3 nach dem 2. -> danach Erschoepfung.
if showLvl and barstate.isconfirmed and l4h != l4h[1] and l4h > 0
    label.new(bar_index, high, "4h  Stufe " + str.tostring(l4h), yloc=yloc.abovebar,
       style=label.style_label_down, color=l4h==3 ? color.new(color.orange,0) : color.new(color.blue,25),
       textcolor=color.white, size=size.small)
if showLvl and barstate.isconfirmed and l1h != l1h[1] and l1h > 0
    label.new(bar_index, low, "1h " + str.tostring(l1h), yloc=yloc.belowbar,
       style=label.style_label_up, color=color.new(color.teal,45), textcolor=color.white, size=size.tiny)
// 4h-Stufe 3 = Trend ausgereizt, Reversal-Gate scharf
bgcolor(showL3 and l4h == 3 ? color.new(color.orange, 93) : na, title="4h Stufe 3")

// ---- v25: STATUS-ZEILE in Klartext ----
f_grund(d) =>
    string txt = "OFFEN - wartet auf Formation"
    if d4h == 0
        txt := "kein klarer 4h-Trend"
    else if er4h < erMin
        txt := "Markt zu verwaschen (" + str.tostring(er4h, "#.##") + " statt " + str.tostring(erMin, "#.##") + ")"
    else if d == d4h
        if l1h >= 3
            txt := "1h schon in Stufe 3 (ausgereizt)"
        else if useMacro and d1d != 0 and d1d != d
            txt := "Tages-Trend laeuft dagegen"
    else
        if l4h < 3
            txt := "4h erst Stufe " + str.tostring(l4h) + " von 3"
        else
            // Roadblock echt auswerten. Bedingung ist einseitig offen:
            // Short braucht Preis >= Hoch*(1-tol), Long Preis <= Tief*(1+tol).
            float refW = d == 1 ? low_ : how
            float refD = d == 1 ? lod  : hod
            bool okW = d == 1 ? (not na(refW) and close <= refW*(1+rbTol)) : (not na(refW) and close >= refW*(1-rbTol))
            bool okD = d == 1 ? (not na(refD) and close <= refD*(1+rbTol)) : (not na(refD) and close >= refD*(1-rbTol))
            string nameW = d == 1 ? "Wochentief" : "Wochenhoch"
            string nameD = d == 1 ? "Tagestief"  : "Tageshoch"
            if okW or okD
                string wo = okW ? nameW : nameD
                float lvl = okW ? refW : refD
                float dpc = (close/lvl - 1) * 100
                txt := "OFFEN - Roadblock erfuellt (" + str.tostring(dpc, "+#.#") + "% zum " + wo + "), wartet auf M/W"
            else
                // Abstand bis zur naechstgelegenen Bedingung zeigen
                float needW = na(refW) ? na : (d == 1 ? (close/(refW*(1+rbTol)) - 1) : (refW*(1-rbTol)/close - 1)) * 100
                float needD = na(refD) ? na : (d == 1 ? (close/(refD*(1+rbTol)) - 1) : (refD*(1-rbTol)/close - 1)) * 100
                float need = na(needW) ? needD : na(needD) ? needW : math.min(needW, needD)
                string wo2 = na(needW) ? nameD : na(needD) ? nameW : (needW <= needD ? nameW : nameD)
                txt := "noch " + str.tostring(need, "#.#") + "% bis zum " + wo2 + " (Roadblock)"
    txt
var label lStat = na
if showTable and barstate.isconfirmed
    label.delete(lStat)
    trendTxt = d4h == 1 ? "steigend" : d4h == -1 ? "fallend" : "unklar"
    tagTxt   = d1d == 1 ? "steigend" : d1d == -1 ? "fallend" : "unklar"
    string posTxt = "keine Position"
    if strategy.position_size != 0 and strategy.opentrades > 0
        eP2 = strategy.opentrades.entry_price(strategy.opentrades-1)
        dir2 = strategy.position_size > 0 ? 1 : -1
        rTxt = na(entryRisk) or entryRisk <= 0 ? "" : "  " + str.tostring((close-eP2)*dir2/entryRisk, "+#.#") + "R"
        posTxt := (dir2 == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(eP2, format.mintick) + rTxt
    txt = "ENGINE-STATUS" +
      "\n4h-Trend:     " + trendTxt + "  (Stufe " + str.tostring(l4h) + " von 3)" +
      "\n1h-Stufe:     " + str.tostring(l1h) + " von 3" + (l1h >= 3 ? "  ausgereizt" : "") +
      "\nTages-Trend:  " + tagTxt +
      "\nKlarheit:     " + str.tostring(er4h, "#.##") + (er4h >= erMin ? "  klar genug" : "  ZU WENIG (ab " + str.tostring(erMin, "#.##") + ")") +
      "\n" +
      "\nLong:   " + f_grund(1) +
      "\nShort:  " + f_grund(-1) +
      "\nPosition: " + posTxt
    lStat := label.new(bar_index, high, txt, yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.black, 8), textcolor=color.white, size=size.normal, textalign=text.align_left)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na)
// 4h-Trend als senkrechte Linie am Trendwechsel: gruen = up, rot = down
showBiasLines = input.bool(true, "4h-Trend als senkrechte Linien", group=grpF)
if showBiasLines and barstate.isconfirmed and d4h != d4h[1] and d4h != 0
    line.new(bar_index, high, bar_index, low, xloc=xloc.bar_index, extend=extend.both, color=d4h == 1 ? color.new(color.green, 40) : color.new(color.red, 40), width=1, style=line.style_dashed)
